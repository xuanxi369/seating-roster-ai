# Copy to .dev.vars; never commit real credentials.
APP_ACCESS_TOKEN="replace-with-a-random-token-at-least-16-characters"
# Configure at least one provider. Leave other providers absent.
# QWEN_API_KEY="your-key"
# DEEPSEEK_API_KEY="your-key"
# ZHIPU_API_KEY="your-key"
# OPENAI_API_KEY="your-key"
# ANTHROPIC_API_KEY="your-key"

# Optional model/base URL overrides. Set matching region for your Qwen account.
# QWEN_MODEL="qwen3-vl-plus"
# QWEN_BASE_URL="https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
# DEEPSEEK_MODEL="deepseek-flash"
# ZHIPU_MODEL="glm-5.3-flash"
# OPENAI_MODEL="gpt-5.4-mini"
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# ANTHROPIC_VERSION="2026-10-21"
